            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: #f5f7fa;
            color: #222;
            line-height: 1.6;
        }

        header {
            background: #0f172a;
            color: white;
            padding: 80px 20px;
            text-align: center;
        }

        header h1 {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        header p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        nav {
            background: white;
            position: sticky;
            top: 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            z-index: 100;
        }

        nav ul {
            display: flex;
            justify-content: center;
            list-style: none;
            padding: 15px;
            gap: 30px;
        }

        nav a {
            text-decoration: none;
            color: #0f172a;
            font-weight: 600;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: auto;
            padding: 60px 0;
        }

        section {
            margin-bottom: 60px;
        }

        h2 {
            color: #0f172a;
            margin-bottom: 20px;
            border-left: 5px solid #2563eb;
            padding-left: 12px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-top: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

        .skills {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .skill {
            background: #2563eb;
            color: white;
            padding: 10px 15px;
            border-radius: 999px;
            font-size: 0.9rem;
        }

        .project {
            margin-bottom: 20px;
        }

        .project h3 {
            margin-bottom: 8px;
            color: #1e3a8a;
        }

        .contact-links a {
            display: inline-block;
            margin-right: 20px;
            color: #2563eb;
            text-decoration: none;
            font-weight: 600;
        }

        footer {
            text-align: center;
            padding: 25px;
            background: #0f172a;
            color: white;
        }

        @media(max-width: 768px) {
            header h1 {
                font-size: 2rem;
            }

            nav ul {
                flex-wrap: wrap;
                gap: 15px;
            }
